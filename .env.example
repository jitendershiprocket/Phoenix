# Project Phoenix - Environment Variables
# Copy to .env and fill values

# Anthropic (Opus 4.6)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (for clone, push, PR)
GITHUB_TOKEN=ghp_...

# Sentry (for --from-sentry)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=shiprocket-1s
SENTRY_PROJECT=demo-app
SENTRY_BASE_URL=https://shiprocket-1s.sentry.io   # for custom subdomain
